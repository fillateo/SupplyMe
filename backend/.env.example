# Copy to .env. Never commit the result.

VDS_MODE=demo                     # demo | live
VDS_APPROVAL_POLICY=external      # autonomous | external | strict

# Vertex AI. With gcloud ADC this is the only line you need.
VDS_PROJECT_ID=
VDS_LOCATION=us-central1
VDS_USE_VERTEX=true

# Leave empty to resolve the newest reachable model — see scripts/check_models.py
VDS_REASONING_MODEL=
VDS_FAST_MODEL=

# Or use the Gemini Developer API instead of Vertex
# VDS_GEMINI_API_KEY=

# Optional integrations. Each one unset degrades to its mock and says so
# at /api/health — nothing silently pretends to have called a Google API.
VDS_MAPS_API_KEY=
VDS_SEARCH_API_KEY=
VDS_SEARCH_ENGINE_ID=
VDS_YOUTUBE_API_KEY=
VDS_GMAIL_SENDER=
VDS_TWILIO_ACCOUNT_SID=
VDS_TWILIO_AUTH_TOKEN=
VDS_TWILIO_FROM_NUMBER=

# Cost guards
VDS_MAX_VENDORS_PER_CATEGORY=8
VDS_MAX_OUTREACH_PER_MISSION=12
VDS_MAX_CALLS_PER_MISSION=3
# Caps the widest fan-out. Research is a tool loop per vendor, and every
# supply-chain node discovers in parallel, so without this a single mission
# issues dozens of concurrent model calls and rate-limits itself.
VDS_MAX_CONCURRENT_RESEARCH=3

# Demo only: compresses scheduled delays, and redelivers events to prove
# idempotency. Both ignored in live mode.
VDS_DEMO_SPEEDUP=1.0
VDS_DEMO_DUPLICATE_RATE=0.0
