# Copy to .env. Never commit the result.

VDS_MODE=demo                     # demo | live  (which product integrations)

# Firestore + Pub/Sub + Cloud Tasks instead of the in-process store, bus and
# scheduler. Independent of VDS_MODE on purpose: locally you usually want real
# Search and Places with in-process state, because provisioning Firestore just
# to try the thing out is a tax on curiosity. Terraform sets this on Cloud Run.
VDS_USE_CLOUD_INFRA=false
VDS_APPROVAL_POLICY=external      # autonomous | external | strict

# Run the whole system deterministically with no Google Cloud project, no API
# key and no network. Same agents, events, storage, scoring and console — only
# the text generation is scripted. Turn this off to use real Gemini.
VDS_USE_SCRIPTED_MODEL=true

# Vertex AI. Used when VDS_USE_SCRIPTED_MODEL=false. With gcloud ADC this is the
# only line you need.
VDS_PROJECT_ID=
VDS_LOCATION=us-central1
VDS_USE_VERTEX=true

# Leave empty to resolve the newest reachable model — see scripts/check_models.py
VDS_REASONING_MODEL=
VDS_FAST_MODEL=

# Or use the Gemini Developer API instead of Vertex
# VDS_GEMINI_API_KEY=

# Optional integrations. Each one unset degrades to its mock and says so
# at /api/health — nothing silently pretends to have called a Google API.
VDS_MAPS_API_KEY=
VDS_SEARCH_API_KEY=
VDS_SEARCH_ENGINE_ID=
VDS_YOUTUBE_API_KEY=
VDS_GMAIL_SENDER=
VDS_TWILIO_ACCOUNT_SID=
VDS_TWILIO_AUTH_TOKEN=
VDS_TWILIO_FROM_NUMBER=

# Cost guards. See docs/COST.md — these are hard stops, not warnings.
# A mission reaching a spend cap fails with a reason and is NOT retried.
VDS_MAX_USD_PER_MISSION=0.50
VDS_MAX_MODEL_CALLS_PER_MISSION=120
# ADK defaults this to 500 per agent run. A research agent needs about five.
VDS_MAX_RESEARCH_LLM_CALLS=12
# Across the whole mission, not per category: 8 per category over 7 nodes is 56
# research loops, and every one costs a tool loop.
VDS_MAX_VENDORS_PER_MISSION=12
VDS_MAX_VENDORS_PER_CATEGORY=8
VDS_MAX_OUTREACH_PER_MISSION=12
VDS_MAX_CALLS_PER_MISSION=3
# Google Places is billed per request and is the priciest call here — well above
# a Gemini call. Web search finds the same suppliers; Places confirms they exist.
VDS_MAX_MAPS_QUERIES_PER_NODE=1

# Thinking tokens are billed as output. Extraction and classification do not
# benefit; planning does. 0 = off, -1 = let the model decide (expensive).
VDS_FAST_THINKING_BUDGET=0
VDS_REASONING_THINKING_BUDGET=2048
# Caps the widest fan-out. Research is a tool loop per vendor, and every
# supply-chain node discovers in parallel, so without this a single mission
# issues dozens of concurrent model calls and rate-limits itself.
VDS_MAX_CONCURRENT_RESEARCH=3

# Demo only: compresses scheduled delays, and redelivers events to prove
# idempotency. Both ignored in live mode.
VDS_DEMO_SPEEDUP=1.0
VDS_DEMO_DUPLICATE_RATE=0.0
