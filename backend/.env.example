# Copy to .env. Never commit the result.
#
# No provider here is ever simulated: each is the real service or the process
# refuses to start, naming the variable that is missing — so a mission either
# read the live web and wrote to a real mailbox, or it never began.
# The one safety valve is SUPPLYME_MAIL_REDIRECT_TO, below.
#
# SUPPLYME_MOCK is the one way to see the system without credentials, and it
# runs no mission at all: it replays a recording of one that did.

# Firestore + Pub/Sub + Cloud Tasks instead of the in-process store, bus and
# scheduler. Locally you usually want in-process state, because provisioning
# Firestore just to try the thing out is a tax on curiosity. Terraform sets
# this on Cloud Run.
SUPPLYME_USE_CLOUD_INFRA=false
# A JSON file the in-process store loads at startup and writes every change
# back to, so a local run keeps its missions across a restart. Point it at a
# snapshot from scripts/export_firestore.py and the console shows the missions
# that really ran, offline and without touching Firestore. Empty = memory only.
SUPPLYME_LOCAL_STORE_PATH=
# `host:port` of a running Firestore emulator. Set it and the store is the real
# FirestoreStore — same client, same transactions, same subcollections — against
# a local process, which is the closest a laptop gets to the deployed data path.
# `docker compose up` sets this for you; `./run.sh emulator` prints what to put
# here. FIRESTORE_EMULATOR_HOST works too, since that is the name the Google
# client libraries read.
SUPPLYME_FIRESTORE_EMULATOR_HOST=
# Autonomous: the agent decides and acts without stopping for approval. What
# bounds it is SUPPLYME_MAIL_REDIRECT_TO below, plus the spend caps — not a human
# clicking send. Use `external` if you unset the redirect.
SUPPLYME_APPROVAL_POLICY=autonomous    # autonomous | external | strict

# Replay a recorded mission instead of running one, for demonstrating the system
# without a model bill or an hour of wall clock. `MOCK=true` works too — that is
# the name to type in front of an audience.
#
# It is a playback, not a fixture world: no provider is bound at all, and every
# supplier, price and source URL comes from a mission that really ran. It cannot
# answer a new objective, only replay the one it has. Refused outright when
# SUPPLYME_USE_CLOUD_INFRA is on.
SUPPLYME_MOCK=false
# Which snapshot to replay. A file, or a directory to take the newest from.
# Empty: the local store file, then ~/supplyme-firestore-backups.
SUPPLYME_MOCK_RECORDING=
# How long a replayed mission takes end to end. The recording is ~1h45m of run.
SUPPLYME_MOCK_DURATION_SECONDS=90
# The longest the console may sit still. Most of a real mission is waiting for a
# supplier to answer; played back proportionally that is a dead minute on screen.
SUPPLYME_MOCK_MAX_GAP_SECONDS=3

# Vertex AI. With gcloud ADC this is the only line you need.
SUPPLYME_PROJECT_ID=
# Two locations, because no single value works for both. SUPPLYME_LOCATION is where
# the service's Google Cloud dependencies live, and Cloud Tasks rejects
# `global`. SUPPLYME_VERTEX_LOCATION is where Vertex serves the model, and Gemini
# 3.x answers only from `global` — a named region 404s without hinting that it
# exists elsewhere. scripts/check_models.py reports what yours resolves to.
SUPPLYME_LOCATION=us-central1
SUPPLYME_VERTEX_LOCATION=global
SUPPLYME_USE_VERTEX=true

# Leave empty to resolve the newest reachable model — see scripts/check_models.py
SUPPLYME_REASONING_MODEL=
SUPPLYME_FAST_MODEL=

# Or use the Gemini Developer API instead of Vertex
# SUPPLYME_GEMINI_API_KEY=

# Required. Without them the process will not start: there is nothing to fall
# back to, which is the point. /api/health names every provider actually bound.
SUPPLYME_MAPS_API_KEY=

# Optional. With a Programmable Search engine, search queries it; without one,
# search uses Gemini's own grounding. Both read the live web.
SUPPLYME_SEARCH_API_KEY=
SUPPLYME_SEARCH_ENGINE_ID=
SUPPLYME_GMAIL_SENDER=
# Send every outbound email here instead of to the supplier. Live missions are
# addressed to real businesses, so set this while testing: the mail really sends,
# and the supplier never hears from you. /api/health says plainly where mail is
# going. Leave empty to write to suppliers for real.
#
# Use a DIFFERENT mailbox from SUPPLYME_SMTP_USER below. Mail arriving from the
# address that sends is treated as our own copy and ignored, so if the two match
# you can answer as the supplier and the mission will never see the reply.
SUPPLYME_MAIL_REDIRECT_TO=

# The mailbox, in both directions. A Gmail app password (myaccount.google.com
# -> Security -> App passwords, needs 2-Step Verification) both sends over SMTP
# and reads replies back over IMAP, so the loop closes on one credential with no
# OAuth client and no consent screen. Replies are read on a poll — Cloud
# Scheduler does it every fifteen minutes in the deployment; locally, POST
# /webhooks/mail/poll yourself.
SUPPLYME_SMTP_USER=
SUPPLYME_SMTP_PASSWORD=

# Cost guards. These are hard stops, not warnings.
# A mission reaching a spend cap fails with a reason and is NOT retried.
SUPPLYME_MAX_USD_PER_MISSION=1.00
SUPPLYME_MAX_MODEL_CALLS_PER_MISSION=300
# ADK defaults this to 500 per agent run. A research agent needs about five.
SUPPLYME_MAX_RESEARCH_LLM_CALLS=12
# Requests in flight to Gemini at once, across every agent including the ADK
# research loop. A rate limit is a queueing problem: on a project with no
# provisioned throughput, 2-4 here turns a burst that mostly 429s into a queue
# that mostly succeeds. Pair it with a small interval to spread the queue out.
SUPPLYME_MAX_CONCURRENT_MODEL_CALLS=4
SUPPLYME_MIN_MODEL_CALL_INTERVAL_SECONDS=0
# Across the whole mission, not per category: 8 per category over 7 nodes is 56
# research loops, and every one costs a tool loop.
SUPPLYME_MAX_VENDORS_PER_MISSION=12
SUPPLYME_MAX_VENDORS_PER_CATEGORY=8
SUPPLYME_MAX_OUTREACH_PER_MISSION=12
# Google Places is billed per request and is the priciest call here — well above
# a Gemini call. Web search finds the same suppliers; Places confirms they exist.
SUPPLYME_MAX_MAPS_QUERIES_PER_NODE=1

# Thinking tokens are billed as output. Extraction and classification do not
# benefit; planning does. 0 = off, -1 = let the model decide (expensive).
SUPPLYME_FAST_THINKING_BUDGET=0
SUPPLYME_REASONING_THINKING_BUDGET=2048
# Caps the widest fan-out. Research is a tool loop per vendor, and every
# supply-chain node discovers in parallel, so without this a single mission
# issues dozens of concurrent model calls and rate-limits itself.
SUPPLYME_MAX_CONCURRENT_RESEARCH=3

# Who outreach is signed by. Empty sends unsigned rather than inventing a name.
SUPPLYME_BUYER_NAME=
