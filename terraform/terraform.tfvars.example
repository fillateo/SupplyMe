project_id = "your-project-id"
region     = "us-central1"
image      = "us-central1-docker.pkg.dev/your-project-id/vendor-discovery/api:latest"

# demo binds the mock providers and makes the service publicly readable so a
# judge can open the link. live binds Gmail, Search and Places and does not.
mode            = "demo"
approval_policy = "external"

# Leave empty to resolve the newest model the project can actually reach.
# Pinning is cheaper: probing the ladder costs two model calls per process.
# Run backend/scripts/check_models.py --project <id> --location <loc> to see
# what yours resolves to before you pin anything.
reasoning_model = ""
fast_model      = ""

# Gemini 3.x is served from the global endpoint, not from a named region.
# This is separate from `region`, which is where Cloud Run itself runs.
vertex_location = "global"

max_instances = 4

# Set these. A budget alert emails you; it does not stop spending — the hard
# stops are max_usd_per_mission below and the app's own caps.
budget_amount_usd = 20
billing_account   = ""
alert_email       = ""

# Hard stops, applied per mission inside the application.
max_usd_per_mission   = 0.50

# Demo only: compresses a 48-hour follow-up wait to about 90 seconds, so a
# judge opening the link sees the mission finish instead of appearing to stall.
demo_speedup = 2000
