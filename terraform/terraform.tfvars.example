# Copy to terraform.tfvars and fill in. Never commit the result.
#
# Every variable here is declared in variables.tf, which carries the long
# reasoning for each one; this file is the short version plus the values you
# actually have to supply.

# --- Required ---------------------------------------------------------------

project_id = "your-project-id"
region     = "us-central1"

# Both images. scripts/deploy.sh builds and pushes them for you.
image         = "us-central1-docker.pkg.dev/your-project-id/supply-me/api:latest"
console_image = "us-central1-docker.pkg.dev/your-project-id/supply-me/console:latest"

# --- Mail: the one setting that reaches strangers ---------------------------
#
# The addresses in a mission belong to real businesses, read off their real
# websites. Leave mail_redirect_to set to a mailbox you own unless you have
# decided, on purpose, to write to them — /api/health states which it is.
# The app password for smtp_user goes in Secret Manager, never here.

# These must be two different mailboxes. Outreach is sent from smtp_user and
# read back from it, and a reply from that same address is discarded as our own
# copy — so pointing mail_redirect_to at it means you answer as the supplier and
# the mission never hears you.
smtp_user        = "sourcing@example.com"
mail_redirect_to = "you@example.com"

# autonomous | external | strict. Autonomous is the point: the agent acts
# without being authorised each time. mail_redirect_to above is what bounds it.
approval_policy = "autonomous"

# --- Model routing ----------------------------------------------------------

# Leave empty to resolve the newest model the project can actually reach.
# Pinning is cheaper: probing the ladder costs two model calls per process.
# Run backend/scripts/check_models.py --project <id> --location <loc> to see
# what yours resolves to before you pin anything.
reasoning_model = ""
fast_model      = ""

# Gemini 3.x is served from the global endpoint, not from a named region. This
# is separate from `region`, which is where Cloud Run itself runs, and it has to
# be: Cloud Tasks rejects `global` outright.
vertex_location = "global"

# --- Access and scale -------------------------------------------------------

# Anyone with the link can open the console. True because the point of
# deploying is that someone can look; what bounds the damage is the caps below
# and the mail redirect above, not the door. Turn it off before pointing this
# at real suppliers with the redirect unset.
publicly_readable = true

max_instances = 4

# Read replies through the Gmail API push path instead of the IMAP poll. Needs
# an OAuth client and a consent screen.
gmail_push = false

# --- Cost -------------------------------------------------------------------

# A budget alert emails you; it does not stop spending. The hard stop is
# max_usd_per_mission, which fails the mission rather than warning about it.
budget_amount_usd = 20
billing_account   = ""
alert_email       = ""

max_usd_per_mission = 1.00
