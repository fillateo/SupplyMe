project_id = "your-project-id"
region     = "us-central1"
image      = "us-central1-docker.pkg.dev/your-project-id/vendor-discovery/api:latest"

# demo binds the mock providers and makes the service publicly readable so a
# judge can open the link. live binds Gmail, Search and Places and does not.
mode            = "demo"
approval_policy = "external"

# Leave empty to resolve the newest model the project can actually reach.
reasoning_model = ""
fast_model      = ""

max_instances = 4

# Set these. A budget alert emails you; it does not stop spending — the hard
# stops are max_usd_per_mission below and the app's own caps.
budget_amount_usd = 20
billing_account   = ""
alert_email       = ""

# Hard stops, applied per mission inside the application.
max_usd_per_mission   = 0.50
